    "hu_get_legislation": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Fetch metadata for any Hungarian legislation by its ELI (type + year + issuer + serial).\n\nUse this for anything other than Acts (torveny) - government decrees, ministerial decrees,\netc. Use `hu_list_doc_types` for valid `doc_type` codes and `hu_list_issuers` for valid\n`issuer` codes (issuer codes are case-sensitive, e.g. `Korm` for Government).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "doc_type": {
              "description": "NJT type code, e.g. ``\"R\"`` (rendelet / decree).",
              "type": "string"
            },
            "issuer": {
              "description": "NJT issuer code, case-sensitive, e.g. ``\"Korm\"`` (Government).",
              "type": "string"
            },
            "serial": {
              "description": "the document's serial number within that year, e.g. ``\"428\"``.",
              "type": "string"
            },
            "year": {
              "description": "4-digit year, e.g. ``\"2016\"``.",
              "type": "string"
            }
          },
          "required": [
            "doc_type",
            "year",
            "issuer",
            "serial"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
