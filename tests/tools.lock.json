    "hu_get_text": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Fetch the full document HTML content of a Hungarian piece of legislation.\n\nFor Acts (torveny), pass `doc_type=\"TV\"` and omit `issuer`. For anything else, pass the\n`issuer` code (case-sensitive - use `hu_list_issuers`).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "doc_type": {
              "description": "NJT type code, e.g. ``\"TV\"`` (torveny / Act) or ``\"R\"`` (rendelet / decree).",
              "type": "string"
            },
            "issuer": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "NJT issuer code, case-sensitive (required for everything except `\"TV\"`)."
            },
            "serial": {
              "description": "the document's serial number within that year.",
              "type": "string"
            },
            "year": {
              "description": "4-digit year.",
              "type": "string"
            }
          },
          "required": [
            "doc_type",
            "year",
            "serial"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "hu_get_text",
        "outputSchema": {
          "additionalProperties": true,
          "description": "Result of ``hu_get_text`` - the full document HTML/text of one act.",
