    "hu_get_text": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Fetch complete legislation HTML, including NJT's deferred blocks.\n\nThe result can be very large (the Civil Code is about 3 MB of HTML). Check\n`byte_size`: if your client truncates tool results, the text you see is not the\nwhole law, so do not conclude that a section is absent from what you received.\n\nFor Acts (torveny), pass `doc_type=\"TV\"` and omit `issuer`. For anything else, pass the\n`issuer` code (case-sensitive - use `hu_list_issuers`).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "doc_type": {
              "description": "NJT type code, e.g. ``\"TV\"`` (torveny / Act) or ``\"R\"`` (rendelet / decree).",
              "type": "string"
            },
            "issuer": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "NJT issuer code, case-sensitive (required for everything except `\"TV\"`)."
            },
            "serial": {
              "description": "the document's serial number within that year.",
              "type": "string"
            },
            "year": {
              "description": "4-digit year.",
              "type": "string"
            }
          },
          "required": [
            "doc_type",
            "year",
            "serial"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "hu_get_text",
        "outputSchema": {
          "additionalProperties": true,
          "description": "Result of ``hu_get_text`` - the full document HTML/text of one act.",
          "properties": {
            "byte_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "content": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "dataset_note": {
              "default": "Nemzeti Jogszabalytar (NJT) is Hungary's official, free-to-use national legislation database, maintained by MKIFK (Magyar Kozlonykiado es Igazsagugyi Forditokozpont Zrt.) at njt.jog.gov.hu. Hungary publishes a genuine, documented national ELI (European Legislation Identifier) URI scheme since 2023 (see /eli/urisemak). Each ELI URI resolves (HTTP 302) to a partially server-rendered HTML page. Large acts may include deferred statutory or annex blocks; hu_get_text reconstructs them via NJT internal AJAX requests. There is no documented public REST/JSON search API; the search/browse UI is an AngularJS SPA that requires a session and JavaScript; documents must be addressed by a known ELI (type + year + serial, and an issuer code for non-Act types).",
              "type": "string"
            },
            "doc_type": {
              "type": "string"
            },
            "eli_uri": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "format": {
              "default": "njt-html-fragment",
              "type": "string"
            },
            "human_readable_citation": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "in_force_date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "issuer": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "serial": {
              "type": "string"
            },
            "source_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
